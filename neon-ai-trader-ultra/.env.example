# NEON AI TRADER ULTRA — Environment Configuration Template
# Copy to .env and fill with your own credentials. NEVER commit .env to version control.

NEON_ENV=development
NEON_DATABASE_URL=sqlite:///./neon_trader.db
NEON_SECRET_KEY=replace-with-64-char-random-hex-secret
NEON_ENCRYPTION_KEY=replace-with-32-byte-fernet-master-secret
NEON_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,capacitor://localhost,https://localhost,http://localhost
NEON_MAX_DATA_AGE_SECONDS=60

# Paper Trading Defaults (DEMO MODE)
NEON_PAPER_INITIAL_BALANCE=100000.0
NEON_PAPER_COMMISSION_BPS=6.0
NEON_PAPER_SLIPPAGE_BPS=3.0

# ------------------------------------------------------------------
# DEMO / TESTNET CREDENTIALS (STRICTLY ISOLATED FROM LIVE)
# ------------------------------------------------------------------
NEON_BINANCE_TESTNET_API_KEY=
NEON_BINANCE_TESTNET_API_SECRET=
NEON_BINANCE_TESTNET_ACCOUNT_ID=BINANCE-TESTNET
NEON_BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision

NEON_MT5_DEMO_LOGIN=
NEON_MT5_DEMO_PASSWORD=
NEON_MT5_DEMO_SERVER=
NEON_MT5_DEMO_BRIDGE_URL=
NEON_MT5_DEMO_BRIDGE_TOKEN=

# ------------------------------------------------------------------
# REAL / LIVE CREDENTIALS (NEVER USE WITHDRAWAL-ENABLED API KEYS)
# ------------------------------------------------------------------
NEON_BINANCE_LIVE_API_KEY=
NEON_BINANCE_LIVE_API_SECRET=
NEON_BINANCE_LIVE_ACCOUNT_ID=
NEON_BINANCE_LIVE_BASE_URL=https://api.binance.com

NEON_MT5_LIVE_LOGIN=
NEON_MT5_LIVE_PASSWORD=
NEON_MT5_LIVE_SERVER=
NEON_MT5_LIVE_BRIDGE_URL=
NEON_MT5_LIVE_BRIDGE_TOKEN=

# ------------------------------------------------------------------
# OPTIONAL ALERT CHANNELS
# ------------------------------------------------------------------
NEON_TELEGRAM_BOT_TOKEN=
NEON_TELEGRAM_CHAT_ID=
NEON_SMTP_HOST=
NEON_SMTP_PORT=587
NEON_SMTP_USER=
NEON_SMTP_PASSWORD=
NEON_ALERT_EMAIL_TO=
